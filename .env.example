# JARVIS settings. The app stores the real file at %APPDATA%\Jarvis\.env
# (edit it through Settings in the GUI). Every key is optional.

# AI models — any one is enough; without them JARVIS uses Ollama if installed.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
JARVIS_DEFAULT_MODEL=

# Local decision model: laya | rules ; english | multilingual
JARVIS_DECISION_ENGINE=laya
JARVIS_LAYA_MODEL=english
JARVIS_DECISION_THRESHOLD=0.45

# Voice
JARVIS_TTS_ENGINE=edge
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_WAKE_WORD=jarvis
JARVIS_VOSK_MODEL=

# Safety & automation
JARVIS_CONFIRM_ACTIONS=1
JARVIS_SAFE_MODE=1
JARVIS_VISION_PROVIDER=auto
JARVIS_OLLAMA_AUTOSTART=1
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Location for weather (empty = auto-detect)
JARVIS_LOCATION=
